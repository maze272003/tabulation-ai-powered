{
  "name": "tabulation-ai-powered",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "convex dev --start \"next dev\"",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && next build",
    "start": "next start",
    "lint": "eslint . --ignore-pattern \"convex/_generated/**\" --ignore-pattern \".graphify/**\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "graphify:extract": "graphify extract . --scope auto --no-description --no-label",
    "graphify:studio": "graphify studio export .graphify/studio",
    "graphify:build": "npm run graphify:extract && npm run graphify:studio"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@convex-dev/better-auth": "^0.12.5",
    "@google/genai": "^2.17.1",
    "@react-pdf/renderer": "^4.6.1",
    "@types/qrcode": "^1.5.6",
    "better-auth": "^1.6.27",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.43.0",
    "lucide-react": "^1.31.0",
    "next": "16.3.0",
    "next-themes": "^0.4.6",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shadcn": "^4.17.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@convex-dev/eslint-plugin": "^2.0.0",
    "@edge-runtime/vm": "^5.0.0",
    "@playwright/test": "^1.62.1",
    "@sentropic/graphify": "^0.17.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript/native": "npm:typescript@^7.0.2",
    "convex-test": "^0.0.55",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
