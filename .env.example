# This environment variable is used in Production and Preview environments to deploy your Convex project
# This variable is not needed in development.
# You can create a Production or Preview deploy key at https://dashboard.convex.dev/project/settings#production-deploy-keys
CONVEX_DEPLOY_KEY=

# Public site URL (Next.js client side). Convex-side SITE_URL is set via `npx convex env set`.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# First platform owner (superadmin) is auto-promoted from this email during
# sign-in, but only while the deployment has no platform owner yet.
# Set it Convex-side with: npx convex env set PLATFORM_OWNER_EMAIL=you@example.com
PLATFORM_OWNER_EMAIL=

# SMTP (Gmail) credentials for server-side email sending.
# Generate an app password at https://myaccount.google.com/apppasswords
# For production hosting, set these in your hosting provider's env settings.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
