+              <span className="text-muted-foreground"> - {tpl.description}</span>
+            </span>
+            {!tpl.isSystem && (
+              <Button
+                variant="ghost"
+                size="sm"
+                onClick={async () => {
+                  try { await remove({ orgSlug, templateId: tpl._id }); }
+                  catch (err: unknown) { toast.error((err as { data?: { message?: string } })?.data?.message ?? "Failed."); }
+                }}
+              >
+                Delete
+              </Button>
+            )}
+          </li>
+        ))}
+      </ul>
+    </div>
+  );
+}
