+
+  if (ev === undefined) return <div>LoadingΓÇª</div>;
+  if (ev === null) return <div>Event not found.</div>;
+
+  return (
+    <div className="space-y-4">
+      <div className="flex gap-2">
+        <Input value={name} onChange={(e) => setName(e.target.value)} />
