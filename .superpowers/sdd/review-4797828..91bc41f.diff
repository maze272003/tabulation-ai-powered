+  action: string;
+  resourceType: string;
+  resourceId: string;
+  before?: unknown;
+  after?: unknown;
+  reason?: string;
+};
+
+export async function writeAudit(ctx: MutationCtx, input: AuditInput): Promise<void> {
+  await ctx.db.insert("auditLogs", {
